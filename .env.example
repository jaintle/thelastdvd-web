# The Last DVD frontend — environment variables
# Copy to .env for local development; set the same in Cloudflare Pages for production.

# WordPress REST API origin. In production this becomes https://cms.thelastdvd.com.
# During local development it may temporarily point to the reachable WordPress URL.
WORDPRESS_BASE_URL=https://cms.thelastdvd.com

# Public site origin used for canonicals, sitemap, OG tags.
PUBLIC_SITE_URL=https://thelastdvd.com

# Beehiiv hosted embed URL for the free newsletter. Leave blank until you have one.
PUBLIC_BEEHIIV_EMBED_URL=

# Optional: force cache-first mode during offline builds. Any truthy value.
# TLD_USE_CACHE=1
